'''
Question 2-Write a Python program that calculates the average (mean) of a given list of numerical               
values without using the built-in sum() function or any other library function that directly 
computes the total.
'''

n1=int(input("Enter the number n1 : "))
n2=int(input("Enter the number n2 : "))
n3=int(input("Enter the number n3 : "))
n4=int(input("Enter the number n4 : "))
n5=int(input("Enter the number n5 : "))
numbers = [n1, n2, n3, n4, n5]

total = 0
count = 0
for num in numbers:
    total+=num
    count+=1

# total = n1+n2+n3+n4+n5
average=total/count

print("Average is : ",average)


