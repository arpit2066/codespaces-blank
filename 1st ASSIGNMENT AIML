'''
Question 5 -Write a Python program to calculate the mean, median, and mode of a given list of
numerical values.
'''

numbers = list(map(int,input("Enter numbers : ").split()))

# for finding mean
total = 0
for num in numbers:
    total += num
mean = total / len(numbers)

# for findig median
numbers.sort()
n = len(numbers)

if n % 2 == 0:
   median = (numbers[n//2 - 1] + numbers[n//2]) / 2     # if n is even
else:
   median = numbers[n//2]     # if n is odd

# for finding mode
frequency = {}      # this empty dictionary
for num in numbers:
   frequency[num] = frequency.get(num, 0) + 1

maximumfreq = max(frequency.values())
mode = [key for key, value in frequency.items() if value == maximumfreq]

print("Mean:", mean)
print("Median:", median)
print("Mode:", mode)




